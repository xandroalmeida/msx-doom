reset_level:
    call load_sector
    call clear_damage_feedback
    xor a
    ld (heading),a
    ld (access_keys),a
    ld (outcome),a
    ld (hint),a
    ld (flash),a
    ld (shot_repeat),a
    ld (effect_timer),a
    ld (weapon),a
    ld e,a
    ld a,8
    call WRTPSG
    ld e,0
    ld a,9
    call WRTPSG
    ld a,max_life
    ld (life),a
    jp set_weapon_sprite

load_sector:
    ld a,(sector)
    add a,a
    ld e,a
    ld d,0
    ld hl,sector_records
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de                       ; compressed terrain
    ld a,(hl)
    ld (player_x+1),a
    inc hl
    ld a,(hl)
    ld (player_y+1),a
    inc hl
    ld a,&80
    ld (player_x),a
    ld (player_y),a
    ld a,(hl)
    ld (ammo),a
    inc hl
    ld b,(hl)
    inc hl
    ld de,enemies
    call load_entities
    ld a,e
    ld (enemy_end),a
    ld b,(hl)
    inc hl
    ld de,props
    call load_entities
    ld a,e
    ld (prop_end),a

    pop hl
    ld de,live_map
    ld c,map_width
unpack_run:
    ld a,(hl)
    inc hl
    ld b,a
    and 3
    srl b
    srl b
    inc b
unpack_cell:
    ld (de),a
    inc e
    dec c
    jr nz,unpack_next
    ld e,0
    inc d
    ld c,map_width
unpack_next:
    djnz unpack_cell
    ld a,d
    cp live_map/256+map_height
    jr nz,unpack_run
    ret

; ROM records hold X, Y, kind and amount. Enemy health starts at the amount.
load_entities:
    push bc
    ld a,d
    cp props/256
    ld a,1
    jr nc,load_entity_position
    push hl
    pop ix
    ld a,(ix+3)
load_entity_position:
    ld (de),a
    inc e
    ld a,&80
    ld (de),a
    inc e
    ld a,(hl)
    inc hl
    ld (de),a
    inc e
    ld a,&80
    ld (de),a
    inc e
    ld a,(hl)
    inc hl
    ld (de),a
    inc e
    xor a
    ld (de),a
    inc e
    ldi                           ; kind
    ldi                           ; amount / key bit mask
    pop bc
    djnz load_entities
    ret

next_enemy:
    ld a,(enemy_end)
    jr next_entity
next_prop:
    ld a,(prop_end)
next_entity:
    ld bc,entity_size
    add iy,bc
    push iy
    pop bc
    cp c
    ret

actor_point:
    push iy
    pop ix
    inc ix
    ret

switch_weapon:
    ld a,(weapon)
    xor 1
    ld (weapon),a
set_weapon_sprite:
    call mark_dirty
    ld a,(weapon)
    or a
    ld hl,pistol_sprite_body
    jr z,write_weapon_sprites
    ld hl,pulse_sprite_body
write_weapon_sprites:
    ld de,&1b08
    ld bc,16
    jp LDIRVM

campaign_action:
    ld a,(pressed)
    bit 0,a
    ret z
    ld a,(outcome)
    cp 4
    jr z,leave_title
    cp 3
    jr z,campaign_restart
    cp 2
    jr nz,load_next
    ld hl,sector
    inc (hl)
load_next:
    jp reset_level
campaign_restart:
    xor a
    ld (sector),a
    call reset_level
    call intro_start
    ld a,4
    jr set_outcome
leave_title:
    call intro_stop
    xor a
set_outcome:
    ld (outcome),a
    jp mark_dirty

stage_exit:
    ld a,(sector)
    cp sector_count-1
    ld a,2
    jr nz,exit_found
    inc a
exit_found:
    ld (outcome),a
    ld e,60
    call event_tone
    jp mark_dirty

render_campaign_panel:
    call clear_view
    ld a,(outcome)
    dec a
    add a,a
    ld e,a
    ld d,0
    ld hl,campaign_panels
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    call draw_panel
    ld a,(outcome)
    cp 4
    call z,intro_meter_to_view
    ld a,(outcome)
    cp 1
    ret nz
    jp render_health

; Channel B mixes a short tone with the weapon noise on channel A.
event_tone:
    ld a,2
    call WRTPSG
    ld a,3
    ld e,0
    call WRTPSG
    call gameplay_mixer
    ld a,9
    ld e,9
    call WRTPSG
    ld a,3
    ld (effect_timer),a
    ret

update_event_tone:
    ld hl,effect_timer
    ld a,(hl)
    or a
    ret z
    dec (hl)
    ret nz
    ld a,9
    ld e,0
    jp WRTPSG

; A plays weapon noise, B plays event tones, and C plays the damage cue.
gameplay_mixer:
    ld a,7
    call RDPSG
    and &c0
    or &31
    ld e,a
    ld a,7
    jp WRTPSG

start_damage_feedback:
    ld a,(JIFFY)
    ld (damage_started),a
    ld a,1
    ld (damage_phase),a
    ld e,9                        ; light red for the impact
    call damage_backdrop
    call gameplay_mixer
    ld a,4
    ld e,126
    call WRTPSG
    ld a,5
    ld e,0
    call WRTPSG
    ld a,10
    ld e,12
    jp WRTPSG

update_damage_feedback:
    ld a,(damage_phase)
    or a
    ret z
    ld hl,damage_started
    ld a,(JIFFY)
    sub (hl)
    cp 12
    jr nc,clear_damage_feedback
    cp 4
    ret c
    ld a,(damage_phase)
    cp 1
    ret nz
    inc a
    ld (damage_phase),a
    ld e,6                        ; dark red for the tail of the flash
    call damage_backdrop
    ld a,4
    ld e,224
    jp WRTPSG

damage_backdrop:
    ld a,(normal_backdrop)
    and &f0
    or e
    jr write_backdrop

clear_damage_feedback:
    xor a
    ld (damage_phase),a
    ld e,a
    ld a,10
    call WRTPSG
    ld a,(normal_backdrop)
write_backdrop:
    ld b,a
    ld c,7
    jp WRTVDP
