reset_level:
    call load_sector
    call clear_damage_feedback
    xor a
    ld (heading),a
    ld (access_keys),a
    ld (outcome),a
    ld (hint),a
    ld (flash),a
    ld (shot_repeat),a
    ld (effect_timer),a
    ld (weapon),a
    ld e,a
    ld a,8
    call WRTPSG
    ld e,0
    ld a,9
    call WRTPSG
    ld a,max_life
    ld (life),a
    call set_weapon_sprite
    jp music_reset

load_sector:
    ld hl,campaign_step
    ld a,campaign_length-1
    sub (hl)
    ld e,a
    ld d,0
    ld hl,campaign_ranks
    add hl,de
    ld e,(hl)
    ld hl,sector_difficulty_order
    add hl,de
    ld a,(hl)
    add a,a
    ld e,a
    ld d,0
    ld hl,sector_records
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de                       ; compressed terrain
    ld a,(hl)
    ld (sector_track),a
    inc hl
    ld a,(hl)
    ld (player_x+1),a
    inc hl
    ld a,(hl)
    ld (player_y+1),a
    inc hl
    ld a,&80
    ld (player_x),a
    ld (player_y),a
    ld a,(hl)
    ld (ammo),a
    inc hl
    ld b,(hl)
    inc hl
    ld de,enemies
    call load_entities
    push hl
    ld a,(difficulty)
    ld c,a
    ld b,0
    ld hl,enemy_skip
    add hl,bc
    ld a,e
    sub (hl)
    ld (enemy_end),a
    pop hl
    ld b,(hl)
    inc hl
    ld de,props
    call load_entities
    ld a,e
    ld (prop_end),a

    pop hl
    call unpack_terrain
    jp randomize_sector

unpack_terrain:
    ; Maps store only interior blocks. Fill in the stone border first.
    ld de,live_map
    ld c,map_height
    ld a,1
unpack_stone_row:
    ld b,map_width
    ld e,0
unpack_stone_cell:
    ld (de),a
    inc e
    djnz unpack_stone_cell
    inc d
    dec c
    jr nz,unpack_stone_row

    ld de,live_map+256+1
    ld c,(map_height-2)/terrain_block_size
unpack_band:
    ld e,1
    ld b,(map_width-2)/terrain_block_size
unpack_block:
    push bc
    ld a,(hl)
    inc hl
    push hl
    ld l,a
    ld h,0
    ld c,a
    ld b,0
    add hl,hl
    add hl,bc
    ld bc,terrain_blocks
    add hl,bc
    push de
    ld b,terrain_block_size
unpack_block_row:
    ld a,(hl)
    inc hl
    ld c,terrain_block_size
unpack_block_cell:
    push af
    and 3
    ld (de),a
    pop af
    rrca
    rrca
    inc e
    dec c
    jr nz,unpack_block_cell
    ld a,e
    sub terrain_block_size
    ld e,a
    inc d
    djnz unpack_block_row
    pop de
    ld a,e
    add a,terrain_block_size
    ld e,a
    pop hl
    pop bc
    djnz unpack_block
    ld a,d
    add a,terrain_block_size
    ld d,a
    dec c
    jr nz,unpack_band
    ret

enemy_skip:
    db 6*entity_size,3*entity_size,0

; ROM records hold X, Y, kind and amount. Enemy health starts at the amount.
load_entities:
    push bc
    ld a,d
    cp props/256
    ld a,1
    jr nc,load_entity_position
    push hl
    pop ix
    ld a,(ix+3)
load_entity_position:
    ld (de),a
    inc e
    ld a,&80
    ld (de),a
    inc e
    ld a,(hl)
    inc hl
    ld (de),a
    inc e
    ld a,&80
    ld (de),a
    inc e
    ld a,(hl)
    inc hl
    ld (de),a
    inc e
    xor a
    ld (de),a
    inc e
    ldi                           ; kind
    ldi                           ; amount / key bit mask
    pop bc
    djnz load_entities
    ret

; Reserve all starting cells, move actors and pickups along free floor, then
; clear the reservations. Solid doors keep each key in its original zone.
randomize_sector:
    ld hl,(level_seed)
    ld (rng_state),hl
    ld a,(player_y+1)
    add a,live_map/256
    ld h,a
    ld a,(player_x+1)
    ld l,a
    push hl
    ld (hl),&80
    ld a,&80
    call place_entities
    ld a,1
    call place_entities
    xor a
    call place_entities
    pop hl
    ld (hl),0
    ret

place_entities:
    ld (placement_pass),a
    ld iy,enemies
place_enemies:
    call place_entity
    call next_enemy
    jr nz,place_enemies
    ld iy,props
place_props:
    ld a,(iy+actor_kind)
    cp prop_door
    jr z,place_prop_next
    cp prop_exit
    jr nz,place_prop
    ld a,(placement_pass)
    cp 1
    jr z,place_prop_next
place_prop:
    call place_entity
place_prop_next:
    call next_prop
    jr nz,place_props
    ret

place_entity:
    ld l,(iy+actor_x+1)
    ld a,(iy+actor_y+1)
    add a,live_map/256
    ld h,a
    ld a,(placement_pass)
    cp 1
    jr z,move_entity
    ld (hl),a
    ret
move_entity:
    ld (hl),0
    ld b,12                       ; bounded attempts, longer walks for supplies and enemies
    ld c,3
    ld a,(iy+actor_kind)
    cp prop_key
    jr z,try_placement
    ld c,6
try_placement:
    push hl
    call placement_random
    pop hl
    push hl
    and 3
    jr z,placement_left
    dec a
    jr z,placement_right
    dec a
    jr z,placement_up
    inc h
    jr placement_cell
placement_left:
    dec l
    jr placement_cell
placement_right:
    inc l
    jr placement_cell
placement_up:
    dec h
placement_cell:
    ld a,(hl)
    or a
    jr z,accept_step
    pop hl
    jr next_placement
accept_step:
    pop de
    dec c
    jr z,save_placement
next_placement:
    djnz try_placement
save_placement:
    ld (hl),&80
    ld (iy+actor_x+1),l
    ld a,h
    sub live_map/256
    ld (iy+actor_y+1),a
    ret

; 16-bit Galois LFSR. A nonzero seed is set when the player starts the campaign.
placement_random:
    ld hl,(rng_state)
    srl h
    rr l
    jr nc,save_random
    ld a,h
    xor &b4
    ld h,a
save_random:
    ld (rng_state),hl
    ld a,l
    xor h
    ret

next_enemy:
    ld a,(enemy_end)
    jr next_entity
next_prop:
    ld a,(prop_end)
next_entity:
    ld bc,entity_size
    add iy,bc
    push iy
    pop bc
    cp c
    ret

actor_point:
    push iy
    pop ix
    inc ix
    ret

switch_weapon:
    ld a,(weapon)
    xor 1
    ld (weapon),a
set_weapon_sprite:
    call mark_dirty
    ld a,(weapon)
    or a
    ld hl,pistol_sprite_body
    jr z,write_weapon_sprites
    ld hl,pulse_sprite_body
write_weapon_sprites:
    ld de,&1b08
    ld bc,16
    jp LDIRVM

campaign_action:
    ld a,(pressed)
    bit 0,a
    ret z
    ld a,(outcome)
    cp 3
    jr z,campaign_restart
    cp 2
    jr nz,load_next
    ld hl,campaign_step
    inc (hl)
    ld hl,(rng_state)
    ld (level_seed),hl
load_next:
    jp reset_level
campaign_restart:
    xor a
    ld (title_direction),a
    ld (music_running),a
    call clear_damage_feedback
    call blank_for_scene_change
    call load_title_video
    call intro_start
    ld a,4
    ld (outcome),a
    jp mark_dirty

title_tick:
    ld a,(pressed)
    bit 0,a
    jr nz,begin_campaign
    call read_direction
    ld hl,title_direction
    cp (hl)
    ret z
    ld (hl),a
    ld hl,difficulty
    cp 3
    jr z,raise_difficulty
    cp 7
    ret nz
    ld a,(hl)
    or a
    ret z
    dec (hl)
    jp mark_dirty
raise_difficulty:
    ld a,(hl)
    cp 2
    ret nc
    inc (hl)
    jp mark_dirty

begin_campaign:
    call intro_stop
    ld hl,(JIFFY)
    ld a,r
    xor l
    ld l,a
    or h
    jr nz,campaign_seed
    inc l
campaign_seed:
    ld (rng_state),hl
    xor a
    ld (campaign_step),a
    call draw_campaign
    ld hl,(rng_state)
    ld (level_seed),hl
    call configure_difficulty
    call blank_for_scene_change
    call load_game_video
    call reset_level
    jp music_start

; Visit ranked maps in order. In each band, take a rank with probability
; picks left / maps left, then store the picks from the end of the list.
draw_campaign:
    ld iy,sector_band_sizes
    ld ix,campaign_ranks+campaign_length-1
    ld de,campaign_band_count*256 ; D = bands left, E = rank
draw_band:
    ld c,(iy+0)
    inc iy
    ld b,maps_per_band
consider_sector:
    ld a,b
    or a
    jr z,advance_sector_rank
    cp c
    jr z,select_sector_rank
random_sector_index:
    call placement_random
    and 7
    cp c
    jr nc,random_sector_index
    cp b
    jr nc,advance_sector_rank
select_sector_rank:
    ld (ix+0),e
    dec ix
    dec b
advance_sector_rank:
    inc e
    dec c
    jr nz,consider_sector
    dec d
    jr nz,draw_band
    ret

configure_difficulty:
    ld a,(difficulty)
    ld b,a
    add a,3
    ld (enemy_sight),a
    ld a,2
    sub b
    ld (enemy_chase_delay),a
    add a,a
    add a,a
    add a,6
    ld (enemy_attack_delay),a
    ret

stage_exit:
    call enemies_remaining
    ld a,hint_clear_enemies
    jp nz,set_exit_hint
    ld a,(campaign_step)
    cp campaign_length-1
    ld a,2
    jr nz,exit_found
    inc a
exit_found:
    ld (outcome),a
    ld e,60
    call event_tone
    call music_mix
    jp mark_dirty

render_campaign_panel:
    call clear_view
    ld a,(outcome)
    cp 4
    jr z,render_title
    dec a
    add a,a
    ld e,a
    ld d,0
    ld hl,campaign_panels
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    call draw_panel
    ld a,(outcome)
    cp 1
    ret nz
    jp render_health

render_title:
    ld hl,title_picture
    ld de,frame
    ld bc,16*32
    ldir
    ld hl,title_panel
    call draw_panel
    call intro_meter_to_view
    ld a,(difficulty)
    add a,a
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld hl,difficulty_names
    add hl,de
    ld de,view+16*32+15
    ld bc,8
    ldir
    ret

; Channel B mixes a short tone with the weapon noise on channel A.
event_tone:
    ld a,2
    call WRTPSG
    ld a,3
    ld e,0
    call WRTPSG
    call gameplay_mixer
    ld a,9
    ld e,9
    call WRTPSG
    ld a,3
    ld (effect_timer),a
    ret

update_event_tone:
    ld hl,effect_timer
    ld a,(hl)
    or a
    ret z
    dec (hl)
    ret nz
    jp music_restore_b

; A plays weapon noise. B and C mix music with event and damage cues.
gameplay_mixer:
    ld a,7
    call RDPSG
    and &c0
    or &31
    ld e,a
    ld a,7
    jp WRTPSG

start_damage_feedback:
    ld a,(JIFFY)
    ld (damage_started),a
    ld a,1
    ld (damage_phase),a
    ld e,9                        ; light red for the impact
    call damage_backdrop
    call gameplay_mixer
    ld a,4
    ld e,126
    call WRTPSG
    ld a,5
    ld e,0
    call WRTPSG
    ld a,10
    ld e,12
    jp WRTPSG

update_damage_feedback:
    ld a,(damage_phase)
    or a
    ret z
    ld hl,damage_started
    ld a,(JIFFY)
    sub (hl)
    cp 12
    jr nc,clear_damage_feedback
    cp 4
    ret c
    ld a,(damage_phase)
    cp 1
    ret nz
    inc a
    ld (damage_phase),a
    ld e,6                        ; dark red for the tail of the flash
    call damage_backdrop
    ld a,4
    ld e,224
    jp WRTPSG

damage_backdrop:
    ld a,(normal_backdrop)
    and &f0
    or e
    jr write_backdrop

clear_damage_feedback:
    xor a
    ld (damage_phase),a
    call music_restore_c
    ld a,(normal_backdrop)
write_backdrop:
    ld b,a
    ld c,7
    jp WRTVDP
