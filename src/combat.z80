; Terrain is shared by movement, rendering, shots and enemy visibility.
game_tick:
    xor a
    ld (dirty),a
    call update_event_tone
    xor a
    ld hl,flash
    or (hl)
    jr z,read_buttons
    dec (hl)
    jr nz,read_buttons
    ld e,0
    ld a,8
    call WRTPSG
    call show_flash
read_buttons:
    xor a
    ld (pressed),a
    ld a,1
    call GTTRIG                    ; joystick A, port 1
    or a
    jr z,joy_button_b
    ld hl,pressed
    set 0,(hl)
joy_button_b:
    ld a,3
    call GTTRIG                    ; joystick B, port 1
    or a
    jr z,keyboard_fire
    ld hl,pressed
    set 1,(hl)
    bit 0,(hl)
    jr z,joy_weapon
    set 2,(hl)                    ; both joystick buttons toggle the menu
    jr keyboard_fire
joy_weapon:
    ld a,1
    call GTSTCK
    cp 1
    jr z,joy_switch_weapon
    cp 3
    jr z,joy_music
    cp 5
    jr nz,keyboard_fire
    ld hl,pressed
    res 1,(hl)
    set 5,(hl)                    ; B + down toggles the live minimap
    jr keyboard_fire
joy_music:
    ld hl,pressed
    res 1,(hl)
    set 6,(hl)                    ; B + right toggles the gameplay soundtrack
    jr keyboard_fire
joy_switch_weapon:
    ld hl,pressed
    res 1,(hl)
    set 3,(hl)                    ; B + up changes weapon
keyboard_fire:
    xor a
    call GTTRIG                    ; Space
    or a
    jr z,keyboard_use
    ld hl,pressed
    set 0,(hl)
keyboard_use:
    ld a,6
    call SNSMAT                    ; left/right Shift share row 6, bit 0
    bit 0,a
    jr nz,keyboard_weapon
    ld hl,pressed
    set 1,(hl)
keyboard_weapon:
    ld a,5
    call SNSMAT                    ; T and X share row 5
    ld hl,pressed
    bit 1,a
    jr nz,keyboard_x
    set 6,(hl)
keyboard_x:
    bit 5,a
    jr nz,keyboard_menu
    set 3,(hl)
keyboard_menu:
    ld a,4
    call SNSMAT                    ; M, N and R share row 4
    ld hl,pressed
    bit 3,a
    jr nz,keyboard_pause
    set 5,(hl)
keyboard_pause:
    bit 2,a
    jr nz,keyboard_retry
    set 2,(hl)
keyboard_retry:
    bit 7,a
    jr nz,current_buttons
    set 4,(hl)
current_buttons:
    ld a,(buttons)
    cpl
    ld hl,pressed
    ld b,(hl)
    and b
    ld (hl),a
    ld a,b
    ld (buttons),a

    ld a,(outcome)
    cp 4
    jp z,title_tick
    ld a,(pressed)
    bit 2,a
    jp nz,toggle_menu
    bit 6,a
    jr z,menu_buttons
    ld a,(outcome)
    or a
    jp z,toggle_music
menu_buttons:
    ld a,(menu_state)
    or a
    jr z,campaign_buttons
    ld a,(buttons)
    bit 6,a
    ret nz
    jp menu_tick
campaign_buttons:
    ld a,(outcome)
    or a
    jr z,play_tick
    jp campaign_action

play_tick:
    ld a,(pressed)
    bit 4,a
    jp nz,reset_level
    bit 3,a
    jp nz,switch_weapon
    bit 5,a
    jr nz,toggle_minimap
    ld a,(buttons)
    and &60
    call z,read_controls
    call check_location
    ld a,(outcome)
    or a
    ret nz
    ld a,(pressed)
    bit 1,a
    call nz,use_door
    ld a,(buttons)
    and 5                        ; fire alone, without the joystick menu chord
    cp 1
    jr z,held_trigger
    xor a
    ld (shot_repeat),a
    jr update_actors
held_trigger:
    ld a,(pressed)
    bit 0,a
    jr nz,fire_trigger
    ld hl,shot_repeat
    ld a,(hl)
    or a
    jr z,update_actors
    dec (hl)
    jr nz,update_actors
fire_trigger:
    ld a,5
    ld (shot_repeat),a
    call fire_shot
update_actors:
    ld iy,enemies
update_enemies:
    call enemy_tick
    ld a,(outcome)
    or a
    ret nz
    call next_enemy
    jr nz,update_enemies
    ret

toggle_minimap:
    ld a,(minimap)
    xor 1
    ld (minimap),a
    jp mark_dirty

; Walking probes four terrain corners and keeps live enemies solid.
player_clear:
    call box_clear
    ret nz
    ld a,&ff
    ld (ignored_actor),a
    ld a,100
    call find_enemy
    jr z,actor_blocks
    xor a
    ret
actor_blocks:
    ld a,1
    or a
    ret

; Z if an actor is inside the radius. IY then points at that actor.
find_enemy:
    ld (actor_radius),a
    ld iy,enemies
find_enemy_test:
    ld a,(iy+actor_hp)
    or a
    jr z,find_enemy_next
    ld a,(iy+actor_x+1)
    sub h
    inc a
    cp 3
    jr nc,find_enemy_next
    ld a,(iy+actor_y+1)
    sub d
    inc a
    cp 3
    jr nc,find_enemy_next
    push iy
    pop bc
    ld a,(ignored_actor)
    cp c
    jr z,find_enemy_next
    call actor_point
    ld a,(actor_radius)
    call near_point
    ret z
find_enemy_next:
    call next_enemy
    jr nz,find_enemy_test
    inc a                        ; enemy_end never occupies the last byte
    ret

check_location:
    ld iy,props
check_pickups:
    call collect_prop
    ld a,(outcome)
    or a
    ret nz
    call next_prop
    jr nz,check_pickups
    ret

collect_prop:
    ld a,(iy+actor_hp)
    or a
    ret z
    ld a,(iy+actor_kind)
    cp prop_door
    ret z
    ld hl,(player_x)
    ld de,(player_y)
    call actor_point
    ld a,112
    call near_point
    ret nz
    ld a,(iy+actor_kind)
    cp prop_exit
    jp z,stage_exit
    cp prop_key
    jr z,collect_key
    cp prop_medic
    jr z,collect_medic
    ld a,(ammo)
    add a,(iy+actor_arg)
    cp 100
    jr c,ammo_collected
    ld a,99
ammo_collected:
    ld (ammo),a
    ld a,4
    jr pickup_feedback
collect_medic:
    ld a,(life)
    cp max_life
    ret nc
    add a,(iy+actor_arg)
    cp max_life
    jr c,medic_collected
    ld a,max_life
medic_collected:
    ld (life),a
    ld a,6
    jr pickup_feedback
collect_key:
    ld a,(access_keys)
    or (iy+actor_arg)
    ld (access_keys),a
    ld a,1
pickup_feedback:
    ld (iy+actor_hp),0
    push af
    ld e,110
    call event_tone
    pop af
    jp set_hint

use_door:
    ld iy,props
find_door:
    ld a,(iy+actor_kind)
    cp prop_door
    jr nz,next_door
    ld a,(iy+actor_hp)
    or a
    jr z,next_door
    ld hl,(player_x)
    ld de,(player_y)
    call actor_point
    ld a,224
    call near_point
    jr z,test_door_key
next_door:
    call next_prop
    jr nz,find_door
    ret
test_door_key:
    ld a,(access_keys)
    and (iy+actor_arg)
    jr nz,unlock_door
    ld a,5
    jp set_hint
unlock_door:
    ld (iy+actor_hp),0
    ld l,(iy+actor_x+1)
    ld a,(iy+actor_y+1)
    add a,live_map/256
    ld h,a
    ld (hl),0
    ld a,(iy+actor_arg)
    and 8
    rrca
    rrca
    push af
    ld e,155
    call event_tone
    pop af
    jp set_hint

fire_shot:
    ld a,(weapon)
    inc a                           ; one charge for pistol, two for pulse
    ld c,a
    ld hl,ammo
    ld a,(hl)
    cp c
    jr nc,consume_round
    ld a,3
    jp set_hint
consume_round:
    sub c
    ld (hl),a
    ld a,2
    ld (flash),a
    call play_shot_sound
    call mark_dirty
    ld a,&ff
    ld (ignored_actor),a
    call facing_vector
    ld (line_dx),bc
    ld (line_dy),de
    ld hl,(player_x)
    ld (line_x),hl
    ld hl,(player_y)
    ld (line_y),hl
    ld a,(weapon)
    or a
    ld a,82
    ld c,48
    jr z,configure_shot
    ld a,112
    ld c,22
configure_shot:
    ld (shot_width),a
    ld a,c                         ; steps of 40/256 of a world cell
    ld (line_count),a
shot_step:
    call advance_line
    ret nz                         ; terrain blocks the shot first
    ld a,(shot_width)
    call find_enemy
    jr z,damage_enemy
    ld hl,line_count
    dec (hl)
    jr nz,shot_step
    ret
damage_enemy:
    dec (iy+actor_hp)
    ret z
    ld a,(weapon)
    or a
    jr z,enemy_stagger
    dec (iy+actor_hp)
    ret z
enemy_stagger:
    ld (iy+actor_wait),4
    ret
enemy_tick:
    ld a,(iy+actor_hp)
    or a
    ret z
    ld a,(iy+actor_wait)
    or a
    jr z,enemy_ready
    dec (iy+actor_wait)
    ret
enemy_ready:
    call actor_position
    ld a,h
    ld bc,(player_x)
    sub b
    call coarse_range
    ret nc
    ld a,d
    ld bc,(player_y)
    sub b
    call coarse_range
    ret nc
    call enemy_sees_player
    ret nz
    ld ix,player_x
    call test_actor_kind
    ld a,128
    jr z,reach_ready
    ld a,192
reach_ready:
    call near_point
    jr nz,chase_player
    ld a,(enemy_attack_delay)
    ld (iy+actor_wait),a
    ld a,(damage_phase)
    or a
    ret nz                        ; simultaneous melee attacks share the impact window
    call start_damage_feedback
    ld hl,life
    dec (hl)
    jp nz,mark_dirty
    ld a,1
    ld (outcome),a
    call music_mix
    jp mark_dirty
chase_player:
    call test_actor_kind
    ld a,(enemy_chase_delay)
    jr z,wait_before_chase
    or a
    jr z,wait_before_chase
    dec a
wait_before_chase:
    ld (iy+actor_wait),a
    ld bc,(player_x)
    call nudge
    jr z,chase_y
    call actor_step_clear
    jr nz,chase_y
    ld (iy+actor_x),l
    ld (iy+actor_x+1),h
    call mark_dirty
chase_y:
    call actor_position
    ex de,hl
    ld bc,(player_y)
    call nudge
    ret z
    ex de,hl
    call actor_step_clear
    ret nz
    ld (iy+actor_y),e
    ld (iy+actor_y+1),d
    jp mark_dirty

actor_step_clear:
    call box_clear
    ret nz
    push iy
    pop bc
    ld a,c
    ld (ignored_actor),a
    push iy
    ld a,82
    call find_enemy
    pop iy
    jp z,actor_blocks
    xor a
    ret

; Z for the standard monster. IY and the position registers survive.
test_actor_kind:
    ld a,(iy+actor_kind)
    or a
    ret

actor_position:
    ld l,(iy+actor_x)
    ld h,(iy+actor_x+1)
    ld e,(iy+actor_y)
    ld d,(iy+actor_y+1)
    ret

coarse_range:
    bit 7,a
    jr z,range_positive
    neg
range_positive:
    ld b,a
    ld a,(enemy_sight)
    ld c,a
    ld a,b
    cp c
    ret

; Move HL at most 28 units toward BC, leaving DE intact. Z if already there.
nudge:
    or a
    sbc hl,bc
    jr c,nudge_up
    ld a,h
    or a
    jr nz,nudge_down
    ld a,l
    or a
    jr z,nudge_stop
    cp 28
    jr c,nudge_arrived
nudge_down:
    push de
    ld de,-28
    jr nudge_offset
nudge_up:
    ld a,h
    inc a
    jr nz,nudge_up_step
    ld a,l
    cp 256-28
    jr nc,nudge_arrived
nudge_up_step:
    push de
    ld de,28
nudge_offset:
    add hl,bc
    add hl,de
    pop de
    ld a,1
    or a
    ret
nudge_arrived:
    ld h,b
    ld l,c
    ld a,1
    or a
    ret
nudge_stop:
    ld h,b
    ld l,c
    ret

; Test 16 evenly spaced samples toward the player's position.
enemy_sees_player:
    push hl
    push de
    ld (line_x),hl
    ld (line_y),de
    ld c,l
    ld b,h
    ld hl,(player_x)
    or a
    sbc hl,bc
    call divide16
    ld (line_dx),hl
    ld c,e
    ld b,d
    ld hl,(player_y)
    or a
    sbc hl,bc
    call divide16
    ld (line_dy),hl
    ld a,16
    ld (line_count),a
sight_step:
    call advance_line
    jr nz,sight_done
    ld hl,line_count
    dec (hl)
    jr nz,sight_step
sight_done:
    pop de
    pop hl
    ret

advance_line:
    ld hl,(line_x)
    ld bc,(line_dx)
    add hl,bc
    ld (line_x),hl
    ex de,hl
    ld hl,(line_y)
    ld bc,(line_dy)
    add hl,bc
    ld (line_y),hl
    ex de,hl
    jp cell

divide16:
    sra h
    rr l
    sra h
    rr l
    sra h
    rr l
    sra h
    rr l
    ret

; A radius (less than a cell), HL/DE coordinates, IX points at X then Y.
; Z on proximity. HL and DE survive.
near_point:
    push hl
    push de
    ld c,(ix+0)
    ld b,(ix+1)
    call near_axis
    jr nc,point_far
    ex de,hl
    ld c,(ix+2)
    ld b,(ix+3)
    call near_axis
    jr nc,point_far
    xor a
    jr point_done
point_far:
    ld a,1
    or a
point_done:
    pop de
    pop hl
    ret

near_axis:
    or a
    sbc hl,bc
    ld b,a
    call abs_hl
    ld a,h
    or a
    ld a,b
    ret nz
    ld a,l
    cp b
    ld a,b
    ret

abs_hl:
    bit 7,h
    ret z
neg_hl:
    xor a
    sub l
    ld l,a
    sbc a,a
    sub h
    ld h,a
    ret

set_hint:
    ld (hint),a
mark_dirty:
    ld a,1
    ld (dirty),a
    ret

play_shot_sound:
    call gameplay_mixer
    ld a,(weapon)
    or a
    ld e,7
    jr z,shot_pitch
    ld e,14
shot_pitch:
    ld a,6
    call WRTPSG
    ld a,8
    ld e,12
    jp WRTPSG

show_flash:
    ld hl,&1b04
    ld a,(flash)
    or a
    ld a,209
    jr z,write_flash
    ld a,159
write_flash:
    jp WRTVRM
