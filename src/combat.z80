; Terrain is shared by movement, rendering, shots and enemy visibility.
game_tick:
    xor a
    ld (dirty),a
    call update_event_tone
    xor a
    ld hl,flash
    or (hl)
    jr z,read_buttons
    dec (hl)
    jr nz,read_buttons
    ld e,0
    ld a,8
    call WRTPSG
    call show_flash
read_buttons:
    xor a
    ld (pressed),a
    ld a,1
    call GTTRIG                    ; joystick A, port 1
    or a
    jr z,joy_button_b
    ld hl,pressed
    set 0,(hl)
joy_button_b:
    ld a,3
    call GTTRIG                    ; joystick B, port 1
    or a
    jr z,keyboard_fire
    ld hl,pressed
    set 1,(hl)
    bit 0,(hl)
    jr z,joy_weapon
    set 2,(hl)                    ; both joystick buttons toggle the menu
    jr keyboard_fire
joy_weapon:
    ld a,1
    call GTSTCK
    cp 1
    jr nz,keyboard_fire
    ld hl,pressed
    res 1,(hl)
    set 3,(hl)                    ; B + up changes weapon
keyboard_fire:
    xor a
    call GTTRIG                    ; Space
    or a
    jr z,keyboard_use
    ld hl,pressed
    set 0,(hl)
keyboard_use:
    ld a,6
    call SNSMAT                    ; left/right Shift share row 6, bit 0
    bit 0,a
    jr nz,keyboard_weapon
    ld hl,pressed
    set 1,(hl)
keyboard_weapon:
    ld a,5
    call SNSMAT                    ; X is row 5, bit 5
    bit 5,a
    jr nz,keyboard_menu
    ld hl,pressed
    set 3,(hl)
keyboard_menu:
    ld a,4
    call SNSMAT                    ; M and R share row 4
    ld hl,pressed
    bit 2,a
    jr nz,keyboard_retry
    set 2,(hl)
keyboard_retry:
    bit 7,a
    jr nz,current_buttons
    set 4,(hl)
current_buttons:
    ld a,(buttons)
    cpl
    ld hl,pressed
    ld b,(hl)
    and b
    ld (hl),a
    ld a,b
    ld (buttons),a

    ld a,(pressed)
    bit 2,a
    jp nz,toggle_menu
    ld a,(menu_state)
    or a
    jp nz,menu_tick
    ld a,(outcome)
    or a
    jr z,play_tick
    jp campaign_action

play_tick:
    ld a,(pressed)
    bit 4,a
    jp nz,reset_level
    bit 3,a
    jp nz,switch_weapon
    call read_controls
    call check_location
    ld a,(outcome)
    or a
    ret nz
    ld a,(pressed)
    bit 1,a
    call nz,use_door
    ld a,(pressed)
    bit 0,a
    call nz,fire_shot
    ld iy,enemy_hp
    call enemy_tick
    ld a,(outcome)
    or a
    ret nz
    ld iy,enemy_brute
    jp enemy_tick

; Walking probes four terrain corners and keeps a live enemy solid.
player_clear:
    call box_clear
    ret nz
    ld iy,enemy_hp
    ld ix,enemy_x
    ld a,100
    call test_first_actor
    jr z,actor_blocks
    ld a,100
    call test_second_actor
    jr z,actor_blocks
    xor a
    ret
actor_blocks:
    ld a,1
    or a
    ret

test_second_actor:
    ld iy,enemy_brute
    ld ix,enemy_brute+actor_x
test_first_actor:
    ld b,a
    ld a,(iy+actor_hp)
    or a
    jr nz,actor_live
    inc a
    ret
actor_live:
    ld a,b
    jp near_point

check_location:
    ld hl,(player_x)
    ld de,(player_y)
    ld ix,exit_point
    ld a,112
    call near_point
    jr nz,check_supply
    jp stage_exit
check_supply:
    ld a,(supplies)
    or a
    jr z,check_key
    ld ix,ammo_point
    ld a,112
    call near_point
    jr nz,check_key
    xor a
    ld (supplies),a
    ld a,(ammo)
    add a,4
    ld (ammo),a
    ld e,110
    call event_tone
    ld a,5
    call set_hint
check_key:
    ld a,(key_waiting)
    or a
    ret z
    ld hl,(player_x)
    ld de,(player_y)
    ld ix,key_point
    ld a,112
    call near_point
    ret nz
    xor a
    ld (key_waiting),a
    ld e,82
    call event_tone
    ld a,(enemy_hp)
    ld hl,enemy_brute
    or (hl)
    ld a,0
    jr nz,key_message
    ld a,1
key_message:
    jp set_hint

use_door:
    ld a,(door_open)
    or a
    ret nz
    ld hl,(player_x)
    ld de,(player_y)
    ld ix,door_point
    ld a,224
    call near_point
    ret nz
    ld a,(enemy_hp)
    ld hl,enemy_brute
    or (hl)
    jr nz,door_locked
    ld a,(key_waiting)
    or a
    jr z,unlock_door
    ld a,6
    jp set_hint
door_locked:
    ld a,3
    jp set_hint
unlock_door:
    ld a,(door_index)
    ld l,a
    ld h,live_map/256
    xor a
    ld (hl),a
    inc a
    ld (door_open),a
    ld e,155
    call event_tone
    ld a,2
    jp set_hint

fire_shot:
    ld a,(weapon)
    inc a                           ; one charge for pistol, two for pulse
    ld c,a
    ld hl,ammo
    ld a,(hl)
    cp c
    jr nc,consume_round
    ld a,4
    jp set_hint
consume_round:
    sub c
    ld (hl),a
    ld a,2
    ld (flash),a
    call play_shot_sound
    call mark_dirty
    ld a,(enemy_hp)
    ld hl,enemy_brute
    or (hl)
    ret z
    call facing_vector
    ld (line_dx),bc
    ld (line_dy),de
    ld hl,(player_x)
    ld (line_x),hl
    ld hl,(player_y)
    ld (line_y),hl
    ld a,(weapon)
    or a
    ld a,82
    ld c,48
    jr z,configure_shot
    ld a,112
    ld c,22
configure_shot:
    ld (shot_width),a
    ld a,c                         ; steps of 40/256 of a world cell
    ld (line_count),a
shot_step:
    call advance_line
    ret nz                         ; terrain blocks the shot first
    ld iy,enemy_hp
    ld ix,enemy_x
    ld a,(shot_width)
    call test_first_actor
    jr z,damage_enemy
    ld a,(shot_width)
    call test_second_actor
    jr z,damage_enemy
    ld hl,line_count
    dec (hl)
    jr nz,shot_step
    ret
damage_enemy:
    dec (iy+actor_hp)
    jr z,enemy_defeated
    ld a,(weapon)
    or a
    jr z,enemy_stagger
    dec (iy+actor_hp)
    jr z,enemy_defeated
enemy_stagger:
    ld (iy+actor_wait),4
    ret
enemy_defeated:
    ld a,(enemy_hp)
    ld hl,enemy_brute
    or (hl)
    ret nz
    ld a,(key_waiting)
    or a
    ld a,1
    jr z,show_next_objective
    ld a,6
show_next_objective:
    jp set_hint

enemy_tick:
    ld a,(iy+actor_hp)
    or a
    ret z
    ld a,(iy+actor_wait)
    or a
    jr z,enemy_ready
    dec (iy+actor_wait)
    ret
enemy_ready:
    call actor_position
    ld a,h
    ld bc,(player_x)
    sub b
    call coarse_range
    ret nc
    ld a,d
    ld bc,(player_y)
    sub b
    call coarse_range
    ret nc
    call enemy_sees_player
    ret nz
    ld ix,player_x
    call test_actor_kind
    ld a,128
    jr z,reach_ready
    ld a,192
reach_ready:
    call near_point
    jr nz,chase_player
    ld (iy+actor_wait),10
    call start_damage_feedback
    ld hl,life
    dec (hl)
    jp nz,mark_dirty
    ld a,1
    ld (outcome),a
    jp mark_dirty
chase_player:
    call test_actor_kind
    ld a,1
    jr z,wait_before_chase
    xor a
wait_before_chase:
    ld (iy+actor_wait),a
    ld bc,(player_x)
    call nudge
    jr z,chase_y
    call actor_step_clear
    jr nz,chase_y
    ld (iy+actor_x),l
    ld (iy+actor_x+1),h
    call mark_dirty
chase_y:
    call actor_position
    ex de,hl
    ld bc,(player_y)
    call nudge
    ret z
    ex de,hl
    call actor_step_clear
    ret nz
    ld (iy+actor_y),e
    ld (iy+actor_y+1),d
    jp mark_dirty

actor_step_clear:
    call box_clear
    ret nz
    call test_actor_kind
    ld ix,enemy_x
    jr nz,test_peer
    ld ix,enemy_brute+actor_x
test_peer:
    ld a,(ix-1)
    or a
    ret z
    ld a,82
    call near_point
    jp z,actor_blocks
    xor a
    ret

; Z for the standard monster. IY and the position registers survive.
test_actor_kind:
    push iy
    pop bc
    ld a,c
    cp enemy_hp & 255
    ret

actor_position:
    ld l,(iy+actor_x)
    ld h,(iy+actor_x+1)
    ld e,(iy+actor_y)
    ld d,(iy+actor_y+1)
    ret

coarse_range:
    bit 7,a
    jr z,range_positive
    neg
range_positive:
    cp 4
    ret

; Move HL at most 28 units toward BC, leaving DE intact. Z if already there.
nudge:
    or a
    sbc hl,bc
    jr c,nudge_up
    ld a,h
    or a
    jr nz,nudge_down
    ld a,l
    or a
    jr z,nudge_stop
    cp 28
    jr c,nudge_arrived
nudge_down:
    push de
    ld de,-28
    jr nudge_offset
nudge_up:
    ld a,h
    inc a
    jr nz,nudge_up_step
    ld a,l
    cp 256-28
    jr nc,nudge_arrived
nudge_up_step:
    push de
    ld de,28
nudge_offset:
    add hl,bc
    add hl,de
    pop de
    ld a,1
    or a
    ret
nudge_arrived:
    ld h,b
    ld l,c
    ld a,1
    or a
    ret
nudge_stop:
    ld h,b
    ld l,c
    ret

; Test 16 evenly spaced samples toward the player's position.
enemy_sees_player:
    push hl
    push de
    ld (line_x),hl
    ld (line_y),de
    ld c,l
    ld b,h
    ld hl,(player_x)
    or a
    sbc hl,bc
    call divide16
    ld (line_dx),hl
    ld c,e
    ld b,d
    ld hl,(player_y)
    or a
    sbc hl,bc
    call divide16
    ld (line_dy),hl
    ld a,16
    ld (line_count),a
sight_step:
    call advance_line
    jr nz,sight_done
    ld hl,line_count
    dec (hl)
    jr nz,sight_step
sight_done:
    pop de
    pop hl
    ret

advance_line:
    ld hl,(line_x)
    ld bc,(line_dx)
    add hl,bc
    ld (line_x),hl
    ex de,hl
    ld hl,(line_y)
    ld bc,(line_dy)
    add hl,bc
    ld (line_y),hl
    ex de,hl
    jp cell

divide16:
    sra h
    rr l
    sra h
    rr l
    sra h
    rr l
    sra h
    rr l
    ret

; A radius (less than a cell), HL/DE coordinates, IX points at X then Y.
; Z on proximity. HL and DE survive.
near_point:
    push hl
    push de
    ld c,(ix+0)
    ld b,(ix+1)
    call near_axis
    jr nc,point_far
    ex de,hl
    ld c,(ix+2)
    ld b,(ix+3)
    call near_axis
    jr nc,point_far
    xor a
    jr point_done
point_far:
    ld a,1
    or a
point_done:
    pop de
    pop hl
    ret

near_axis:
    or a
    sbc hl,bc
    ld b,a
    call abs_hl
    ld a,h
    or a
    ld a,b
    ret nz
    ld a,l
    cp b
    ld a,b
    ret

abs_hl:
    bit 7,h
    ret z
neg_hl:
    xor a
    sub l
    ld l,a
    sbc a,a
    sub h
    ld h,a
    ret

set_hint:
    ld (hint),a
mark_dirty:
    ld a,1
    ld (dirty),a
    ret

play_shot_sound:
    call gameplay_mixer
    ld a,(weapon)
    or a
    ld e,7
    jr z,shot_pitch
    ld e,14
shot_pitch:
    ld a,6
    call WRTPSG
    ld a,8
    ld e,12
    jp WRTPSG

show_flash:
    ld hl,&1b04
    ld a,(flash)
    or a
    ld a,209
    jr z,write_flash
    ld a,135
write_flash:
    jp WRTVRM
