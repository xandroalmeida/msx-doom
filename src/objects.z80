; Objects are projected onto a tile grid, then clipped against each wall ray.
obj_art:     equ &f180
rel_x:       equ &f182
rel_y:       equ &f183
camera_sin:  equ &f184
camera_cos:  equ &f185
view_depth:  equ &f186
side_sign:   equ &f187
object_record: equ &f188
obj_tiles:   equ object_record
obj_row:     equ object_record+2
obj_depth:   equ object_record+4
obj_size:    equ object_record+5
obj_column:  equ object_record+6
record_size: equ 7
obj_left:    equ &f18f
queue_end:   equ &f196
best_record: equ &f198
best_depth:  equ &f19a
object_queue: equ &f000           ; up to 29 visible records of seven bytes each

render_scene:
    ld a,(menu_state)
    or a
    jp nz,render_menu
    ld a,(outcome)
    or a
    jp nz,render_campaign_panel
    call render_view
    ld hl,object_queue
    ld (queue_end),hl

    ld a,(heading)
    add a,a
    ld e,a
    ld d,0
    ld hl,camera_vectors
    add hl,de
    ld a,(hl)
    ld (camera_sin),a
    inc hl
    ld a,(hl)
    ld (camera_cos),a
    ld iy,enemies
render_enemies:
    call render_actor
    call next_enemy
    jr nz,render_enemies
    ld iy,props
render_props:
    call render_prop
    call next_prop
    jr nz,render_props
    jr render_object_queue

render_actor:
    ld a,(iy+actor_hp)
    or a
    ret z
    ld bc,creature_tiles
    ld a,(iy+actor_kind)
    or a
    jr z,project_entity
    ld bc,brute_tiles
    jr project_entity

render_prop:
    ld a,(iy+actor_hp)
    or a
    ret z
    ld a,(iy+actor_kind)
    cp prop_door
    ret z
    add a,a
    ld e,a
    ld d,0
    ld hl,prop_art
    add hl,de
    ld c,(hl)
    inc hl
    ld b,(hl)
project_entity:
    call actor_position
    jp project_object

; Draw far to near. A consumed record has zero depth.
render_object_queue:
    xor a
    ld (best_depth),a
    ld hl,object_queue+4
    ld a,(queue_end)
    add a,4
    ld c,a
find_farthest:
    ld a,l
    cp c
    jr z,draw_farthest
    ld a,(best_depth)
    cp (hl)
    jr nc,scan_next_object
    ld a,(hl)
    ld (best_depth),a
    ld (best_record),hl
scan_next_object:
    ld de,record_size
    add hl,de
    jr find_farthest
draw_farthest:
    ld a,(best_depth)
    or a
    jr z,render_hud
    ld hl,(best_record)
    ld de,-4
    add hl,de
    ld de,object_record
    ld bc,record_size
    ldir
    ld hl,(best_record)
    ld (hl),0
    ld a,(obj_size)
    ld (obj_left),a
    call paint_object_column
    jr render_object_queue

render_hud:
    ld a,(minimap)
    or a
    call nz,draw_minimap
    ld hl,hud_template
    ld de,hud
    ld bc,32
    ldir
    call render_health
    ld a,(weapon)
    or a
    ld hl,weapon_names
    jr z,hud_weapon
    ld hl,weapon_names+7
hud_weapon:
    ld de,hud+hud_weapon_offset
    ld bc,7
    ldir
    ld a,(sector)
    inc a
    call digit_tile
    ld (hud+hud_sector_offset),a
    ld a,(ammo)
    ld b,0
ammo_tens:
    cp 10
    jr c,ammo_digit
    sub 10
    inc b
    jr ammo_tens
ammo_digit:
    push af
    ld a,b
    or a
    jr z,ammo_remainder
    call digit_tile
    ld (hud+hud_ammo_offset),a
ammo_remainder:
    pop af
ammo_units:
    call digit_tile
    ld (hud+hud_ammo_offset+1),a
    ld a,(hint)
    add a,a
    ld e,a
    ld d,0
    ld hl,hud_hint_addresses
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,hud+hud_hint_offset
    ld bc,hud_hint_width
    ldir
    ret

render_health:
    ld hl,hud+hud_life_offset
    ld de,(hud_hearts)             ; E = outline, D = filled heart
    ld a,(life)
    ld c,a
    ld b,max_life
health_heart:
    ld a,c
    or a
    ld a,e
    jr z,health_draw
    dec c
    ld a,d
health_draw:
    ld (hl),a
    inc hl
    djnz health_heart
    ret

digit_tile:
    ld e,a
    ld d,0
    ld hl,hud_digits
    add hl,de
    ld a,(hl)
    ret

; HL/DE world position, BC points to the four pre-scaled tile sets.
; Calculate signed relative position in sixteenths of a world cell.
project_object:
    ld (obj_art),bc
    ld bc,(player_x)
    call relative_axis
    ret nz
    ld (rel_x),a
    ex de,hl
    ld bc,(player_y)
    call relative_axis
    ret nz
    ld (rel_y),a

    ; Transform onto forward (depth) and right (side) camera axes.
    ld a,(rel_y)
    ld e,a
    ld a,(camera_cos)
    call signed_product
    push hl
    ld a,(rel_x)
    ld e,a
    ld a,(camera_sin)
    call signed_product
    pop de
    or a
    sbc hl,de
    call divide64
    ld a,h
    or a
    ret nz
    ld a,l
    cp 4
    ret c
    ld (view_depth),a

    ld a,(rel_y)
    ld e,a
    ld a,(camera_sin)
    call signed_product
    push hl
    ld a,(rel_x)
    ld e,a
    ld a,(camera_cos)
    call signed_product
    pop de
    add hl,de
    call divide64
    ld a,h
    ld (side_sign),a
    call abs_hl
    ld a,h
    or a
    ret nz
    ld a,(view_depth)
    cp l
    ret c

    ; Horizontal focal length is approximately 25 tile columns.
    ld d,h
    ld e,l
    add hl,hl
    add hl,de
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de
    ld e,a
    ld d,0
    ld b,0
divide_screen_x:
    or a
    sbc hl,de
    jr c,screen_x_ready
    inc b
    jr divide_screen_x
screen_x_ready:
    ld a,(side_sign)
    or a
    ld a,b
    jr z,center_x
    neg
center_x:
    add a,16
    ld c,a
    ld a,(view_depth)
    ld e,a
    ld hl,object_depths
    add hl,de
    ld a,(hl)
    ld (obj_depth),a

    ; The creature grows from one tile at distance to four tiles up close.
    ld a,(view_depth)
    ld b,4
    cp 22
    jr c,size_ready
    dec b
    cp 36
    jr c,size_ready
    dec b
    cp 72
    jr c,size_ready
    dec b
size_ready:
    ld a,b
    ld (obj_size),a
    srl a
    ld e,a
    ld a,c
    sub e
    ld (obj_column),a
    ld a,8
    sub e
    ld h,0
    ld l,a
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,view
    add hl,de
    ld (obj_row),hl
    dec b
    ld e,b
    ld d,0
    ld hl,object_offsets
    add hl,de
    ld e,(hl)
    ld hl,(obj_art)
    add hl,de
    ld (obj_tiles),hl
    ld hl,object_record
    ld de,(queue_end)
    ld bc,record_size
    ldir
    ld (queue_end),de
    ret

paint_object_column:
    ld a,(obj_column)
    cp 32
    jr nc,advance_object
    ld e,a
    ld d,0
    ld hl,wall_depth
    add hl,de
    ld a,(obj_depth)
    cp (hl)
    jr nc,advance_object
    ld hl,(obj_row)
    add hl,de
    ex de,hl
    ld hl,(obj_tiles)
    ld a,(obj_size)
    ld b,a
paint_object_tile:
    ld a,(hl)
    or a
    jr z,clear_object_tile
    ld (de),a
clear_object_tile:
    inc hl
    ld a,e
    add a,32
    ld e,a
    jr nc,next_object_tile
    inc d
next_object_tile:
    djnz paint_object_tile
advance_object:
    ld a,(obj_size)
    ld e,a
    ld d,0
    ld hl,(obj_tiles)
    add hl,de
    ld (obj_tiles),hl
    ld hl,obj_column
    inc (hl)
    ld hl,obj_left
    dec (hl)
    jr nz,paint_object_column
    ret

relative_axis:
    or a
    sbc hl,bc
    call divide16
    ld a,l
    add a,a
    sbc a,a
    cp h
    ld a,l
    ret

divide64:
    call divide16
    sra h
    rr l
    sra h
    rr l
    ret

; Signed 8-bit A times signed 8-bit E. Camera components use seven bits.
signed_product:
    ld c,a
    xor e
    push af
    ld a,c
    or a
    jp p,positive_camera
    neg
positive_camera:
    ld c,a
    ld a,e
    or a
    jp p,positive_displacement
    neg
positive_displacement:
    ld e,a
    ld d,0
    ld hl,0
    ld b,7
multiply_bit:
    srl c
    jr nc,no_add
    add hl,de
no_add:
    sla e
    rl d
    djnz multiply_bit
    pop af
    or a
    ret p
    jp neg_hl
