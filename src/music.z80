; Gameplay music runs in the second cartridge page. PSG A is reserved for
; shots. B and C play lead and bass except while their effects own the channel.
music_enabled: equ &f151
music_running: equ &f152
music_last: equ &f153
music_phase: equ &f154
music_interval: equ &f155
music_loop: equ &f156              ; start of the track's bar order
music_next: equ &f158              ; next frame in the current bar
music_voice_b: equ &f15a
music_voice_c: equ &f15c
music_order: equ &f19c             ; next bar pointer in the track order

music_reset:
    ld a,(music_running)
    or a
    ret z
music_start:
    ld a,1
    ld (music_running),a
    ld a,(sector_track)
    ld e,a
    add a,a
    add a,e                       ; each track has a pointer and a tempo byte
    ld e,a
    ld d,0
    ld hl,game_music_tracks
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld a,(hl)
    ld (music_interval),a
    ld (music_loop),de
    ld (music_order),de
    ld a,(JIFFY)
    ld (music_last),a
    xor a
    ld (music_phase),a
    call gameplay_mixer
    jr music_next_bar

music_tick:
    ld a,(outcome)
    or a
    ret nz
    ld a,(music_running)
    or a
    ret z
    ld a,(JIFFY)
    ld c,a
    ld hl,music_last
    sub (hl)
    ret z
    ld (hl),c
    ld b,a
    ld a,(intro_rate)               ; 5/300 s at 60 Hz, 6/300 s at 50 Hz
    ld c,a
    ld a,(music_phase)
music_catch_up:
    add a,c
    ld hl,music_interval
    cp (hl)
    jr c,music_next_tick
    sub (hl)
    push bc
    push af
    call music_read_frame
    pop af
    pop bc
music_next_tick:
    djnz music_catch_up
    ld (music_phase),a
    ret

music_read_frame:
    ld hl,(music_next)
    ld a,(hl)
    cp &ff                         ; FFh ends a bar
    jr nz,music_unpack_frame
music_next_bar:
    ld hl,(music_order)
music_read_order:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld a,d
    or e                           ; a null pointer loops the track
    jr nz,music_bar_ready
    ld hl,(music_loop)
    jr music_read_order
music_bar_ready:
    ld (music_order),hl
    ex de,hl
    ld a,(hl)
music_unpack_frame:
    inc hl
    ld c,(hl)
    inc hl
    ld (music_next),hl
    call music_unpack_word
    ld (music_voice_b),de
    ld a,c
    call music_unpack_word
    ld (music_voice_c),de

music_mix:
    call music_restore_b
    jp music_restore_c

music_unpack_word:
    ld l,a
    ld h,0
    add hl,hl
    ld de,game_music_words
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ret

music_restore_b:
    ld a,(effect_timer)
    or a
    ret nz
    ld hl,music_voice_b
    ld c,2
    jr music_restore_voice

music_restore_c:
    ld a,(damage_phase)
    or a
    ret nz
    ld hl,music_voice_c
    ld c,4

music_restore_voice:
    ld e,0                         ; volume zero leaves the other channels alone
    ld a,(outcome)
    or a
    jr nz,music_write_volume
    ld a,(music_running)
    or a
    jr z,music_write_volume
    ld a,(music_enabled)
    or a
    jr z,music_write_volume
    ld a,(hl)
    inc hl
    or (hl)
    jr z,music_write_volume
    dec hl
    ld e,(hl)
    ld a,c
    call write_psg
    inc hl
    ld a,(hl)
    and 15
    ld e,a
    ld a,c
    inc a
    call write_psg
    ld a,(hl)
    rrca
    rrca
    rrca
    rrca
    and 15
    ld e,a
music_write_volume:
    ld a,c
    srl a
    add a,8
    jp WRTPSG

toggle_music:
    ld a,(music_enabled)
    xor 1
    ld (music_enabled),a
    push af
    call music_mix
    pop af
    xor 1
    add a,7
    jp set_hint
